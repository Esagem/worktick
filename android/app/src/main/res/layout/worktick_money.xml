<?xml version="1.0" encoding="utf-8"?>
<!--
  WorkTick Terminal widget — 4×1 layout
  Rendered as a single ImageView bitmap (RemoteViews can't draw arbitrary
  shapes, brackets, or capped rules natively). The provider draws everything
  onto a Canvas in MoneyTickerWidgetProvider.renderTerminalBitmap(...).

  Tap target: the root container opens SmoothActivity.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wt_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wt_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:contentDescription="@string/app_name" />

</FrameLayout>
