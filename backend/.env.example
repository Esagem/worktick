# WorkTick backend environment variables
# Copy this file to .env and fill in real values.
# .env is gitignored — never commit it.

# === Required ===

# Google OAuth — get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# Where Google redirects after OAuth — for local dev, leave as-is
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# Auth token shared between widgets and the backend
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_SHARED_SECRET=replace-me-with-a-long-random-string

# === Optional ===

# What event title to match in your Google Calendar
WORK_EVENT_TITLE=McCrary Summer Work

# Hourly wage in USD (gross)
HOURLY_RATE=30.00

# Local SQLite path (production uses /data/worktick.db on Fly)
DB_PATH=./worktick.db

# Timezone for boundary computation
TIMEZONE=America/Chicago

# Calendar polling interval in seconds (default 6 hours)
POLL_INTERVAL_SECONDS=21600
